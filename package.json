{
  "name": "earthscope",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "EARTHSCOPE — Earth System Trend Detection & Investigation Platform (NASA Space Apps 2026: Be An Earth System Trend Detective!)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/postbuild.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "data:textures": "node scripts/build-textures.mjs",
    "data:gibs": "node scripts/build-gibs-meta.mjs",
    "data:atlas": "tsx scripts/build-atlas.ts",
    "data:snapshots": "tsx --tsconfig tsconfig.app.json scripts/build-snapshots.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "data:external": "node scripts/build-external.mjs",
    "deploy": "node scripts/deploy-vercel.mjs",
    "guide:pdf": "node docs/guide-ar/render.mjs",
    "deploy:netlify": "npm run build && npx --yes netlify-cli@latest deploy --prod --no-build --dir dist"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "d3-array": "^3.2.5",
    "d3-geo": "^3.1.2",
    "d3-scale": "^4.0.3",
    "d3-shape": "^3.2.1",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "three": "^0.187.0",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/d3-array": "^3.2.2",
    "@types/d3-geo": "^3.1.1",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "playwright-core": "^1.65.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
